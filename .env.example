# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is gitignored — never commit a real key. The app loads .env automatically
# (via python-dotenv) when you run `streamlit run app.py` or `python build.py`.

# FRED API key — free and instant: https://fredaccount.stlouisfed.org/apikeys
# Powers the monthly Realtor.com county listing series (median list price, price
# per square foot, days on market, active/new listings). Optional: without it the
# monthly listing metrics degrade to "—"; the FHFA, ACS, and permits panels still
# render.
FRED_API_KEY=your_fred_api_key_here

# Census Data API key — free: https://api.census.gov/data/key_signup.html
# Powers the American Community Survey housing panel (median home value, rent,
# owner-occupancy). The Census API also serves a limited number of keyless
# requests per day, so this is recommended but not strictly required.
CENSUS_API_KEY=your_census_api_key_here

# HUD USER API token — free (register, then create a token):
# https://www.huduser.gov/portal/dataset/fmr-api.html
# Powers the Fair Market Rents affordability context. Optional: without it the
# FMR rows degrade to "—".
HUD_TOKEN=your_hud_token_here
